{
  "version": 2,
  "builds": [
    {
      "src": "aplicacionWZC/madres-digitales-backend/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "aplicacionWZC/madres-digitales-backend/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "aplicacionWZC/madres-digitales-backend/api/index.js"
    }
  ],
  "installCommand": "cd aplicacionWZC/madres-digitales-backend && npm install",
  "buildCommand": "cd aplicacionWZC/madres-digitales-backend && npx prisma generate --schema=prisma/schema.prisma",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "aplicacionWZC/madres-digitales-backend/api/index.js": {
      "maxDuration": 30
    }
  }
}
